XRPL_WSS_URL=wss://testnet.xrpl-labs.com
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network
VERIFIER_API_KEY_TESTNET=
COSTON2_DA_LAYER_URL=
# Optional when the selected DA Layer endpoint requires authentication.
COSTON2_DA_LAYER_API_KEY=
TRANSACTION_STORE_PATH=./data/executor-jobs.json
HEALTH_PORT=3001
# Server-side URL used by the web app to read operator executor job progress.
EXECUTOR_STATUS_URL=http://127.0.0.1:3001
MAX_JOB_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_MS=5000
FDC_PREPARE_TIMEOUT_MS=60000
FDC_FINALIZATION_TIMEOUT_MS=300000
FDC_PROOF_TIMEOUT_MS=120000

# Optional read-only verifier smoke test. It only prepares a request and never
# submits or signs a Coston2 transaction.
RUN_FDC_SMOKE_TEST=false
FDC_SMOKE_XRPL_TX_ID=
FDC_SMOKE_PROOF_OWNER=

# Prompt 6 Coston2 integration test. Xaman credentials are application API
# credentials, never an XRPL seed or private key.
XAMAN_API_KEY=
XAMAN_API_SECRET=
INTEGRATION_XRPL_SOURCE_ADDRESS=
INTEGRATION_FXRP_RECIPIENT=
INTEGRATION_AMOUNT_DROPS=1000000
# Set only for the separately reviewed settlement phase.
CONFIRM_COSTON2_EXECUTION=NO

# Executor's Flare private key — pays gas for executeDirectMinting /
# executeInstruction calls. Testnet key only. Never commit a real .env file.
EXECUTOR_PRIVATE_KEY=
# Public address preferred by the web review flow. If omitted locally, it is
# derived server-side from EXECUTOR_PRIVATE_KEY and is never sent as a secret.
EXECUTOR_ADDRESS=

# Which XRPL address this executor watches for incoming Smart Accounts /
# direct-minting payments — must match one of MasterAccountController's
# registered operator wallets, or the Core Vault address for plain mints.
WATCHED_XRPL_ADDRESS=
# Optional override for Smart Account operator XRPL wallet (defaults to MasterAccountController.getXrplProviderWallets()).
WATCHED_OPERATOR_XRPL_ADDRESS=
